rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User-liked and saved articles
    match /saved_articles/{savedId} {
      allow read, write: if true;
    }

    // Live community polls
    match /polls/{pollId} {
      allow read, write: if true;
    }

    // Published Cinema & News Articles
    match /published_articles/{articleId} {
      allow read, write: if true;
    }

    // User poll votes
    match /poll_votes/{voteId} {
      allow read, write: if true;
    }

    // Developer Role Registry
    match /dev_roles/{roleId} {
      allow read, write: if true;
    }
  }
}
